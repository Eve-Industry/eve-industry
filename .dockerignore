# Kept out of the Dockerfile.app image: secrets, VCS data, local
# dependencies (composer installs its own) and runtime files.
.git
.github
.env
.env.*
!.env.example
vendor
**/node_modules
.phpunit.result.cache
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
public/app
